# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# Anchored to the repo root: an unanchored `build/`/`dist/` would also swallow
# frontend/dist, which IS committed (see below).
/build/
/dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / env
.env
.env.*
!.env.example

# Node / frontend
node_modules/
# frontend/dist IS committed on purpose: the backend serves it, so lab members need
# neither Node nor a build step. Re-run `npm run build` and commit it after UI changes.
# tsc -b build outputs
*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js

# Runtime data (paths overridable via env)
var/
examples/demo/
*.sqlite
*.sqlite3

# macOS / editors
.DS_Store
.vscode/
.idea/

# Claude Code local config (not part of the app)
.claude/
