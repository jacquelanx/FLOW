# Always gitignored .env!!!!!

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional others (uncomment + fill as needed)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Azure OpenAI -- see README for how to set this up
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://apimd.mdanderson.edu/dig/foundry
# AZURE_OPENAI_API_VERSION=2025-03-01-preview      # optional; a default is used if unset
# AZURE_OPENAI_AUTH_HEADER=api-key                 # optional; this is already the default

# Local Ollama needs no key; override its host only if not the default:
# OLLAMA_HOST=http://localhost:11434
