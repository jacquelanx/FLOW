# FLOW provider API keys — copy this file to `.env` and fill in the keys you have.
#
#   cp .env.example .env
#
# FLOW loads `.env` automatically on `flow run` and `flow serve` (it never overrides a
# variable already set in your shell). Keys are used host-side for provider calls and are
# NEVER passed into the Docker container. `.env` is gitignored — do not commit real keys.
#

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Azure OpenAI 
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# Direct Azure uses "api-key"; an APIM gateway uses "Ocp-Apim-Subscription-Key".
# AZURE_OPENAI_AUTH_HEADER=api-key


# Optional others (uncomment + fill as needed)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# FIREWORKS_API_KEY=
# BASETEN_API_KEY=
# NVIDIA_API_KEY=

# Local Ollama needs no key; override its host only if not the default:
# OLLAMA_HOST=
